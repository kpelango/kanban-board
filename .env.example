# Copy to .env (never commit .env). The start scripts pass it into the container.

# Local Supabase transaction pooler (from `npx supabase start`). The start scripts swap
# 127.0.0.1 for host.docker.internal so the container can reach it.
DATABASE_URL=postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres

# Any long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SESSION_SECRET_KEY=

# Creates the dev accounts `user` (admin) and `e2e-test-user`, both with password `password`.
# Local only: never set this on a hosted database.
SEED_DEV_USERS=1

# AI assistant (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional
# AI_DAILY_LIMIT=30          # assistant messages per registered account per 24 hours
# AI_DAILY_LIMIT_GUEST=10    # the same for demo guests
# CRON_SECRET=               # enables GET /api/cron/cleanup-guests with "Authorization: Bearer <secret>"
